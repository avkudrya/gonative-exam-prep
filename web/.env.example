# Public origin of this site (canonical URLs, metadata).
SITE_ORIGIN=http://127.0.0.1:3302

# Origin that BFF writes must come from (CSRF check). Production: https://exams.mnemonicwords.app.
# Outside production it may be left empty: the request's own origin is trusted.
EXAMS_WEB_ORIGIN=http://127.0.0.1:3302

# MultiAdmin Exams API. HTTPS, or HTTP on loopback only. Server-side only; no GoNative app token is used:
# sessions are per-user `exams-web` tokens kept in an httpOnly cookie.
EXAMS_API_URL=http://127.0.0.1:8000/api/exam

# Public Google Sign-In client ID (the same web client as Worksheets, with this origin authorised).
# Empty: email sign-in only.
EXAMS_GOOGLE_CLIENT_ID=
